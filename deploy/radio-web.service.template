# radio-web systemd unit — installed by install_linda.sh (placeholders are substituted).
# The service reads all runtime configuration from /etc/radio-web/radio.env
# (mode, port, role usernames, session secret) — nothing secret lives here.
[Unit]
Description=LINDA live radio viewer (@RADIO_MODE@ mode)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=@SERVICE_USER@
WorkingDirectory=@REPO_ROOT@
EnvironmentFile=/etc/radio-web/radio.env
Environment=DISPLAY=:0
Environment=XAUTHORITY=@SERVICE_HOME@/.Xauthority
Environment=XDG_RUNTIME_DIR=/run/user/@SERVICE_UID@
# Reset-Radio failure output survives the process being replaced (the web UI
# and journal read it back after the restart).
Environment=RADIO_RESET_LOG=/var/log/radio-web/reset.log
LogsDirectory=radio-web
# ProtectHome=read-only below makes $HOME unwritable, so every library that
# caches under ~/.cache dies at runtime — striqt raised
# "[Errno 30] Read-only file system: '~/.cache/striqt'" on every compute tick
# and the viewer sat forever on "waiting for first frame". CacheDirectory=
# gives us a writable /var/cache/radio-web owned by the service user; the
# variables point each library at it instead of at $HOME. Keep all four.
CacheDirectory=radio-web
Environment=XDG_CACHE_HOME=/var/cache/radio-web
Environment=MPLCONFIGDIR=/var/cache/radio-web/matplotlib
Environment=NUMBA_CACHE_DIR=/var/cache/radio-web/numba
ExecStart=@REPO_ROOT@/deploy/run_service.sh
Restart=always
RestartSec=3
TimeoutStopSec=10
KillSignal=SIGINT
# Hardening. NOTE: do NOT add NoNewPrivileges=true — the Reset Radio button
# relies on one narrowly-scoped passwordless sudo command (see
# live/install_radio_web_sudoers.sh), which NoNewPrivileges would break.
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=@REPO_ROOT@
# The radio pipeline logs verified operations to stdout — journald keeps them:
#   journalctl -u radio-web -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
